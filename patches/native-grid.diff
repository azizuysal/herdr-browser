+fn full_placement(relayed: bool, native_herdr: bool, (cols, rows): (u32, u32)) -> Placement {
+    if relayed || native_herdr {
+        Placement::Cells { cols, rows }
+    } else {
+        Placement::Cursor { z: 0, offset: (0, 0) }
+    }
+}
