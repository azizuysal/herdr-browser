+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_native_herdr_selects_the_herdr_placement() {
+        let env = |program: &str| crate::terminal::SessionEnv::of_session(
+            [("TERM_PROGRAM".to_owned(), program.to_owned())].into_iter().collect(),
+        );
+        assert!(crate::terminal::native_herdr(&env("herdr-app")));
+        assert!(!crate::terminal::native_herdr(&env("ghostty")));
+        assert!(!crate::terminal::native_herdr(&crate::terminal::SessionEnv::of_session(Default::default())));
+    }
+
+    #[test]
+    fn full_frames_use_cells_for_native_herdr_and_relayed_terminals() {
+        let cells = Placement::Cells { cols: 80, rows: 24 };
+        assert_eq!(full_placement(false, true, (80, 24)), cells);
+        assert_eq!(full_placement(true, false, (80, 24)), cells);
+        assert_eq!(full_placement(false, false, (80, 24)), Placement::Cursor { z: 0, offset: (0, 0) });
+    }
